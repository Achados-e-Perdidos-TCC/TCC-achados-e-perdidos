# Copie este arquivo para .env e ajuste os valores.

# Postgres (usado pelo docker-compose.yml e pelo application.yml)
POSTGRES_DB=achados_e_devolvidos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DB_URL=jdbc:postgresql://localhost:5432/achados_e_devolvidos
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT - gere um valor com: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# E-mail (SMTP) - usado pelo fluxo de esqueci-minha-senha. Defaults apontam para
# o sandbox do Mailtrap (https://mailtrap.io) - crie uma inbox gratuita em
# Email Testing > Inboxes e pegue usuário/senha em "SMTP Settings".
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# Link de redefinição de senha enviado por e-mail (?token=... é anexado
# automaticamente) e validade do token, em minutos.
PASSWORD_RESET_REDIRECT_URI=http://localhost:5173/reset-password
PASSWORD_RESET_EXPIRATION_MINUTES=30

# Credencial (Basic Auth) para abrir /swagger-ui e /v3/api-docs - combine um
# usuario/senha com o time (frontend + backend) e nao reaproveite senha de
# outro lugar. Sem default: sem isso, a aplicacao nao sobe.
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Pasta local onde as imagens enviadas via POST /api/v1/uploads/images ficam
# gravadas (opcional, default "./uploads" relativo ao diretorio de trabalho).
UPLOAD_DIR=./uploads

# Rate limiting de POST /api/v1/auth/login (todas opcionais, ja tem default).
# ip-* e um limite largo por IP; email-* e a defesa real contra forca bruta
# numa conta especifica (so conta tentativa falha).
LOGIN_RATE_LIMIT_IP_CAPACITY=60
LOGIN_RATE_LIMIT_IP_REFILL_MINUTES=1
LOGIN_RATE_LIMIT_EMAIL_CAPACITY=5
LOGIN_RATE_LIMIT_EMAIL_REFILL_MINUTES=15
